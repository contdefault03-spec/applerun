# ---- Game server (server/index.js reads .env automatically) ----
PORT=8787
# Google Gemini key for AI NPC conversations. Server-side only — never shipped to browsers.
GEMINI_API_KEY=
# Optional: model override (default gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest
# Optional: Firebase service account (JSON string or path to the .json file) to persist
# profiles/money/inventory/NPC memory in Firestore instead of data/store.json
FIREBASE_SERVICE_ACCOUNT=
# Optional: comma-separated list of allowed browser origins for the WebSocket
ALLOWED_ORIGINS=

# ---- Client build (Vite) ----
# URL of the game server when the client is hosted elsewhere (e.g. Netlify)
VITE_SERVER_URL=
# Optional TURN server for voice chat through strict NATs
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_PASS=
